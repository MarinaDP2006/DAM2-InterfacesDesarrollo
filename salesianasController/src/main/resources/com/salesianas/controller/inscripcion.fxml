<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_LEFT" prefHeight="491.0" prefWidth="295.0" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.salesianas.controller.InscripcionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Título -->
    <Label text="DAM EVENTS">
        <font>
            <Font name="System Bold" size="16.0" />
        </font>
    </Label>

    <!-- Campo Nombre -->
    <VBox spacing="4.0">
        <Label text="Nombre:" />
        <TextField fx:id="txtNombre" promptText="Escribe tu nombre..." />
    </VBox>

    <!-- Campo Actividad -->
    <VBox spacing="4.0">
        <Label text="Actividad:" />
        <ComboBox fx:id="cmbActividad" maxWidth="Infinity" promptText="Seleccionar..." />
    </VBox>

    <!-- Selección de Turno -->
    <VBox spacing="4.0">
        <Label text="Turno:" />
        <RadioButton fx:id="rbManana" text="Mañana">
            <toggleGroup>
                <ToggleGroup fx:id="grupoTurno" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbTarde" text="Tarde" toggleGroup="$grupoTurno" />
    </VBox>
   <RadioButton mnemonicParsing="false" text="Acepto las condiciones y me inscribo" />
   <RadioButton mnemonicParsing="false" text="Necesito equipo" />

    <!-- Botones de Acción -->
    <HBox alignment="CENTER" spacing="15.0">
        <Button fx:id="btnLimpiar" onAction="#limpiar" prefWidth="120.0" text="LIMPIAR" />
        <Button fx:id="btnInscribirme" disable="true" onAction="#inscribir" prefWidth="120.0" text="INSCRIBIRME" />
    </HBox>

    <!-- Línea Separadora -->
    <Separator prefWidth="200.0" />

    <!-- Etiqueta de Resultado -->
    <Label fx:id="lblResultado" alignment="TOP_CENTER" prefHeight="130.0" prefWidth="278.0" text="Datos de la inscripcion: " textAlignment="CENTER" textOverrun="WORD_ELLIPSIS" wrapText="true">
      <font>
         <Font name="System Bold" size="12.0" />
      </font></Label>
</VBox>
