<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.salesianas.manageralumnos.controller.ListadoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label alignment="CENTER" styleClass="title-label" text="Gestión de Alumnos - Salesianas DAM" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS">
      <font>
         <Font name="System Bold" size="14.0" />
      </font></Label>

    <TableView fx:id="tablaAlumnos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
            <TableColumn fx:id="colApellidos" prefWidth="160.0" text="Apellidos" />
            <TableColumn fx:id="colEmail" prefWidth="200.0" text="Correo Electrónico" />
            <TableColumn fx:id="colCurso" prefWidth="100.0" text="Curso" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#handleNuevo" styleClass="button" text="Añadir Alumno" />
        <Button fx:id="btnEditar" onAction="#handleEditar" styleClass="button" text="Editar Alumno" />
        <Button fx:id="btnEliminar" onAction="#handleEliminar" styleClass="button, button-danger" text="Eliminar Alumno" />
    </HBox>
</VBox>
