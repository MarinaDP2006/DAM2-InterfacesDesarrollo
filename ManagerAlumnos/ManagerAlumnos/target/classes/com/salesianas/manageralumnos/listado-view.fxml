<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salesianas.manageralumnos.controller.ListadoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Gestión de Alumnos - Salesianas DAM" styleClass="title-label" />

    <TableView fx:id="tablaAlumnos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="130.0" />
            <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="160.0" />
            <TableColumn fx:id="colEmail" text="Correo Electrónico" prefWidth="200.0" />
            <TableColumn fx:id="colCurso" text="Curso" prefWidth="100.0" />
        </columns>
    </TableView>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Añadir Alumno" onAction="#handleNuevo" styleClass="button" />
        <Button fx:id="btnEliminar" text="Eliminar Alumno" onAction="#handleEliminar" styleClass="button, button-danger" />
    </HBox>
</VBox>