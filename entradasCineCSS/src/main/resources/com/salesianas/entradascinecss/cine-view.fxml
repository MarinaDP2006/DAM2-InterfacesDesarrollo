<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefWidth="520.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.salesianas.entradascinecss.EntradasCineController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <!-- Título principal -->
        <Label styleClass="h2, title" text="Reserva de Entradas de Cine">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Mensaje de estado -->
        <Label fx:id="lblEstado" styleClass="alert, alert-warning" text="¡SELECCIONA PELICULA Y HORA PARA SEGUIR!" wrapText="true" />

        <!-- Formulario de Selección -->
        <GridPane hgap="12.0" vgap="14.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="140.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="310.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <!-- 1. Película -->
                <Label text="Película:" GridPane.rowIndex="0">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
                <ComboBox fx:id="cbPelicula" prefWidth="310.0" promptText="-- Selecciona una película --" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <!-- 2. Número de entradas con botones + y - -->
                <Label text="Número de entradas:" GridPane.rowIndex="1">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Button fx:id="btnMenos" mnemonicParsing="false" styleClass="btn, btn-secondary" text="−" />
                        <Label fx:id="lblEntradas" styleClass="h4" text="1">
                            <font><Font name="System Bold" size="16.0" /></font>
                            <padding><Insets left="10.0" right="10.0" /></padding>
                        </Label>
                        <Button fx:id="btnMas" mnemonicParsing="false" styleClass="btn, btn-secondary" text="+" />
                    </children>
                </HBox>

                <!-- 3. Sesión (RadioButtons con ToggleGroup) -->
                <Label text="Sesión:" GridPane.rowIndex="2">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="15.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <RadioButton fx:id="rbSesion1" mnemonicParsing="false" text="17:00">
                            <toggleGroup>
                                <ToggleGroup fx:id="tgSesion" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="rbSesion2" mnemonicParsing="false" text="19:30" toggleGroup="$tgSesion" />
                        <RadioButton fx:id="rbSesion3" mnemonicParsing="false" text="22:00" toggleGroup="$tgSesion" />
                    </children>
                </HBox>

                <!-- 4. Extras (CheckBoxes) -->
                <Label text="Extras opcionales:" GridPane.rowIndex="3">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <children>
                        <CheckBox fx:id="chkPalomitas" mnemonicParsing="false" text="Palomitas + Bebida (+5,50 €)" />
                        <CheckBox fx:id="chkPremium" mnemonicParsing="false" text="Asiento Premium (+2,00 €)" />
                    </children>
                </VBox>
            </children>
        </GridPane>

        <!-- Botones de Acción -->
        <HBox alignment="CENTER" spacing="12.0">
            <children>
                <Button fx:id="btnCalcular" mnemonicParsing="false" styleClass="btn, btn-primary" text="CALCULAR PRECIO" />
                <Button fx:id="btnLimpiar" mnemonicParsing="false" styleClass="btn, btn-danger" text="LIMPIAR" />
                <Button fx:id="btnConfirmar" disable="true" mnemonicParsing="false" styleClass="btn, btn-success" text="CONFIRMAR RESERVA" />
            </children>
            <VBox.margin>
                <Insets top="5.0" />
            </VBox.margin>
        </HBox>

        <!-- Resumen y Total -->
        <VBox spacing="5.0">
            <children>
                <Label text="DATOS DE LA RESERVA:">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
                <TextArea fx:id="txtResumen" editable="false" prefHeight="100.0" promptText="..." wrapText="true" />
                <Label fx:id="lblTotal" alignment="CENTER" prefWidth="500.0" styleClass="alert, alert-info" text="TOTAL: 0,00 €">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </children>
</VBox>
