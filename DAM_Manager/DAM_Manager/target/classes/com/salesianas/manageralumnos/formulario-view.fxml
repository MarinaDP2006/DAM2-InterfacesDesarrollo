<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="440.0" spacing="18.0" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.salesianas.manageralumnos.controller.FormularioController">

    <stylesheets>
        <URL value="@dam-manager.css" />
    </stylesheets>

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <Label fx:id="lblTitulo" styleClass="page-title" text="Nuevo alumno" />

    <GridPane hgap="14.0" styleClass="form-card" vgap="12.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <columnConstraints>
            <ColumnConstraints minWidth="90.0" prefWidth="90.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" />
        </columnConstraints>

        <Label styleClass="field-label" text="Nombre" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombre" promptText="Ej. Lucía" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label styleClass="field-label" text="Apellidos" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtApellidos" promptText="Ej. García López" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label styleClass="field-label" text="Correo" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtCorreo" promptText="nombre@salesianas.org" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label styleClass="field-label" text="Curso" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="cmbCurso" maxWidth="Infinity" promptText="Selecciona un curso" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button cancelButton="true" onAction="#cancelar" styleClass="btn-secondary" text="Cancelar" />
        <Button fx:id="btnGuardar" defaultButton="true" onAction="#guardar" styleClass="btn-primary" text="Guardar" />
    </HBox>
</VBox>
